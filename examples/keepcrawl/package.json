{
  "name": "keepcrawl",
  "version": "0.1.0",
  "description": "Self-hosted, Karakeep-style bookmark-everything app: Firecrawl fetches pages, any OpenAI-compatible LLM (FreeLLMAPI by default) tags and summarises them.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch src/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  }
}
